{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "e2e",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ],
  "exclude": []
}
